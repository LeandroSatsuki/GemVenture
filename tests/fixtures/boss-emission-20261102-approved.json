      "file": "approved-scenery-emission.js",
      "old": "function capture(c,kind,data){if(dead)return;",
      "new": "function bossSource(data){if(!BOSS_EMISSION_PROFILES[data.index]||!(data.alpha>0))return;const {x,y}=data.anchor,key=[data.index,x.toFixed(2),y.toFixed(2)].join(':');if(bossKeys.has(key)||bossSources.length>=BOSS_EMISSION_SPEC.maxSources)return;bossKeys.add(key);const gy=(y-57.5)/16;bossSources.push({index:data.index,x,y,alpha:Math.min(1,data.alpha),color:BOSS_EMISSION_PROFILES[data.index].color,grid:{x:(x-50-2*gy)/22,y:gy}});}\n function capture(c,kind,data){if(dead)return;\n  if(kind==='boss-source'){if(inView(c,data.anchor.x,data.anchor.y))bossSource(data);return;}\n  if(kind==='boss-raster'){const v=bossMaterials.raster(data.image);if(!v?.pixels)return;const q=context(c);q.save();q.globalAlpha=data.alpha;q.drawImage(v.canvas,...data.rect);q.restore();draws++;return;}\n  if(kind==='boss-mesh'){if(!(data.alpha>0)||!inView(c,data.anchor.x,data.anchor.y))return;const v=bossMaterials.mesh(data.faces,data.index,data.cache);if(!v)return;const q=context(c);q.save();q.transform(...data.matrix);q.globalAlpha=data.alpha;\n   if(!data.cache&&draws){q.globalCompositeOperation='destination-out';q.beginPath();for(const f of data.faces){f.points.forEach(([a,b,z],i)=>i?q.lineTo(a+b/11,b*8/11-z):q.moveTo(a+b/11,b*8/11-z));q.closePath();}q.fillStyle='#000000';q.fill();}\n   q.globalCompositeOperation='source-over';q.drawImage(v.canvas,v.x,v.y,v.w,v.h);q.restore();bossSource(data);draws++;return;}\n"
    },
